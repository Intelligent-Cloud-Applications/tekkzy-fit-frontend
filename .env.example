# Application
VITE_APP_NAME=GYM ACCESS
VITE_API_URL=/api
# Production build uses .env.production
# Beta build uses .env.beta (npm run build:beta)
# VITE_GYM_API_KEY belongs in *.local or CI secrets only
VITE_DEVICE_PROVIDER=mock
VITE_PAYMENT_PROVIDER=mock
VITE_NOTIFICATION_PROVIDER=mock

# Local server
PORT=8787
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# Database
# local-json works without PostgreSQL for development and offline gyms.
# Set DATABASE_PROVIDER=postgres and supply DATABASE_URL for production.
DATABASE_PROVIDER=local-json
DATABASE_URL=postgres://gym:gym@localhost:5432/gymaccess
LOCAL_DATA_DIR=./data

# Cloud API (serverless) — server only
CLOUD_API_URL=
GYM_API_KEY=

# Razorpay — server only. Never put the secret in the frontend.
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AWS — server only. Frontend talks to this API, never to AWS directly.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Live face terminal (official device web API — same cmds as http://DEVICE_HOST)
DEVICE_HOST=192.168.29.231
DEVICE_WEB_USER=admin
DEVICE_WEB_PASSWORD=

# Demo login (frontend seed only)
# admin@gymaccess.in / Admin@123
